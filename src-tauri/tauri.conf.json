{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DreamLauncher",
  "version": "2.0.0",
  "identifier": "org.dreamlauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DreamLauncher",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/n80406763-tech/dreamlauncher/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQzg1NUY1MkEyMzcxMzgKUlVUTE9RQUFBQUFDMEFBQUFBRUFBRUFBQkFBQUEzQUFBQUFBQUREdDBkQXRxb0N2cUpQOHhHczN3MEdhQnp2QitCdzVCRmdjNGFPNFpUSnhmUkpCMEJBMU1NMHd4c2xPTnZ2TUVUaFFZTXVCRnZnPQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
